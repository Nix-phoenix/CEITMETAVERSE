generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Connection URL moved to prisma.config.ts per Prisma config changes.
// Set your connection string in Script/DataBase/.env (DATABASE_URL)
// and use prisma.config.ts for migrations and client options.

model User {
  id             String   @id @map("id") @db.Text
  username       String   @unique @map("username") @db.VarChar(50)
  email          String   @unique @map("email") @db.VarChar(100)
  password       String   @map("password") @db.VarChar(255)
  fullName       String?  @map("full_name") @db.VarChar(100)
  profilePicture String?  @map("profile_picture") @db.VarChar(255)
  bio            String?  @map("bio") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  games Game[] @relation("UserGames")

  @@map("users")
}

model Game {
  id         String   @id @map("id") @db.Text
  title      String   @map("title") @db.VarChar(200)
  shortDesc  String?  @map("short_desc") @db.Text
  fullDesc   String?  @map("full_desc") @db.Text
  gameType   String?  @map("game_type") @db.VarChar(50)
  tags       Json?    @map("tags")
  coverImage String?  @map("cover_image") @db.VarChar(255)
  gameFile   String?  @map("game_file") @db.VarChar(255)
  creatorId  String?  @map("creator_id") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  creator User? @relation("UserGames", fields: [creatorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([creatorId], name: "games_creator_id_idx")
  @@map("games")
}
